# Server-side only. Never prefix these with VITE_.
GRID_MANAGER_CLIENT_ID=
GRID_MANAGER_CLIENT_SECRET=
GRID_MANAGER_API_URL=https://api.innerviewtech.com/
GRID_MANAGER_RECORD_URL_TEMPLATE=https://app.innerviewinsights.com/pole/{poleId}
GRID_MANAGER_ASSET_FIELDS=CustomerPoleId,Gisid,ObservedPoleId
# Optional existing OAuth bearer token instead of client credentials.
GRID_MANAGER_BEARER_TOKEN=
# Map codes attached to individual readings, not an account-wide unit setting.
# Metric=mm and Imperial=in are built in. Unknown codes need per-reading review.
GRID_MANAGER_UNIT_MAP={}
# Set only when the returned per-reading RSM field is confirmed.
GRID_MANAGER_RSM_FIELD=
# Public Cloudflare Pages only: verified Access application configuration.
GRID_MANAGER_ACCESS_TEAM_DOMAIN=
GRID_MANAGER_ACCESS_AUD=
